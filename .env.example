# Optional. The local synthetic demo does not require credentials.
LAMINA_API_HOST=127.0.0.1
LAMINA_API_PORT=8000
LAMINA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Anonymous Lucy demo workspace cookie. Production HTTPS must set Secure=true.
LAMINA_DEMO_COOKIE_NAME=lamina_demo_workspace
LAMINA_DEMO_COOKIE_SECURE=false
LAMINA_DEMO_COOKIE_SAMESITE=lax
LAMINA_DEMO_COOKIE_DOMAIN=
LAMINA_DEMO_WORKSPACE_TTL_HOURS=168
# Short-lived, hashed first-contact convergence window; not a workspace ID.
LAMINA_DEMO_BOOTSTRAP_TTL_SECONDS=120

# Frontend (copy to frontend/.env if the API is not on the default URL)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend Supabase JWT verification. Never expose service-role keys to Vite.
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=300

# Explicitly bounded local synthetic-identity shortcut; keep false in public production.
LAMINA_DEMO_VERIFICATION_ENABLED=false

# Public, read-only physician identity directory. A local snapshot takes precedence.
LAMINA_NPPES_DATABASE=
LAMINA_NPPES_LIVE_ENABLED=true
LAMINA_NPPES_TIMEOUT_SECONDS=10

# Optional backend-only professional drafting/enrichment/training-branch integration.
# Calls happen only on explicit enrich/draft actions or a ternary Depends branch.
# LAMINA_RESPONSES_ENABLED remains accepted as a legacy alias.
LAMINA_OPENAI_ENABLED=false
LAMINA_OPENAI_MODEL=
OPENAI_API_KEY=

# Clinical source: synthetic (offline default) or medplum (explicit; no silent fallback).
LAMINA_CLINICAL_SOURCE=synthetic
MEDPLUM_BASE_URL=
MEDPLUM_TOKEN_URL=
MEDPLUM_FHIR_BASE_URL=
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
MEDPLUM_PROJECT_ID=
MEDPLUM_REQUEST_TIMEOUT_SECONDS=20
