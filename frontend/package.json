{
  "name": "lamina-consult-network-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test test/*.test.mjs",
    "preview": "vite preview",
    "e2e": "node e2e/support/run.ts e2e",
    "e2e:capture": "node e2e/support/run.ts capture",
    "e2e:screens": "node e2e/support/run.ts screens",
    "e2e:demo-screens": "playwright test -c playwright.demo.config.ts",
    "e2e:typecheck": "tsc -p e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9"
  }
}
